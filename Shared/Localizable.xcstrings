            "value" : "Timer"
          }
        }
      }
    },
    "Timers sync with your iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timer werden mit deinem iPhone synchronisiert."
          }
        }
      }
    },
    "Timers you edit here also appear on your Apple Watch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timer, die du hier bearbeitest, erscheinen auch auf deiner Apple Watch."
          }
        }
      }
    },
    "Turns the countdown sounds on or off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet die Countdown-Töne ein oder aus."
          }
        }
      }
    },
    "With the phone locked, the Lock Screen and the Dynamic Island show the countdown and a notification signals the end of the rest." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei gesperrtem iPhone zeigen Sperrbildschirm und Dynamic Island den Countdown, eine Mitteilung meldet das Ende der Pause."
          }
        }
      }
    }
