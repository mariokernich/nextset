    "Starts a rest timer with any duration." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet einen Pausen-Timer mit beliebiger Dauer."
          }
        }
      }
    },
    "Starts one of your quick rest timers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet einen deiner Schnell-Timer."
          }
        }
      }
    },
    "Tap a timer to start" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timer antippen zum Starten"
          }
        }
      }
    },
    "The last seconds of every rest are marked with a tap and a beep. Sounds play over your music and even in silent mode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die letzten Sekunden jeder Pause werden mit Vibration und Ton markiert. Die Töne sind über deiner Musik und auch im Stumm-Modus zu hören."
          }
        }
      }
    },
    "Time for your next set." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeit für deinen nächsten Satz."
          }
        }
      }
    },
